datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Whitelist {
  adminUploadBatch  String?
  createdAt         DateTime @default(now())
  email             String?
  id                String   @id @default(cuid())
  location          String?
  name              String?
  participantStatus String?
  phone             String?
  updatedAt         DateTime @updatedAt
}

model File {
  altText      String?
  createdAt    DateTime @default(now())
  filename     String?
  height       Int?
  id           String   @id @default(cuid())
  mimetype     String?
  publicId     String?
  resourceType String?
  size         Int?
  updatedAt    DateTime @updatedAt
  uploader     String?
  url          String?
  width        Int?
}

model UserNotification {
  createdAt      DateTime      @default(now())
  id             String        @id @default(cuid())
  isRead         Boolean?
  notification   Notification? @relation(fields: [notificationId], references: [id])
  notificationId String?
  readAt         DateTime?
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
}

model Notification {
  attachments       String?
  audience          String?
  channel           String?
  content           String?
  createdAt         DateTime           @default(now())
  id                String             @id @default(cuid())
  title             String?
  typeField         String?
  updatedAt         DateTime           @updatedAt
  userNotifications UserNotification[]
}

model User {
  createdAt         DateTime           @default(now())
  email             String?            @unique
  firstName         String?
  id                String             @id @default(cuid())
  lastName          String?
  location          String?
  participantStatus String?
  password          String
  phone             String?
  roles             Json
  updatedAt         DateTime           @updatedAt
  userNotifications UserNotification[]
  username          String             @unique
}
